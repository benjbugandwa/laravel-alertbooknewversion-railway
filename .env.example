AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Railway Bucket expose aussi BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION et ENDPOINT.
# Ces variables sont lues automatiquement par config/filesystems.php si les AWS_* ne sont pas renseignees.
# Ne mettez jamais "undefined" comme region: utilisez auto ou la variable REGION du bucket.

VITE_APP_NAME="${APP_NAME}"
